#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

cd "$(dirname "$0")/.."
variant=development
case "${1-}" in
    '') ;;
    --fleet) variant=fleet ;;
    --playground) variant=playground ;;
    *) printf 'Usage: %s [--fleet|--playground]\n' "$0" >&2; exit 2 ;;
esac
version=$(tr -d '[:space:]' <mkosi.version)
if [ "$variant" = fleet ]; then
    release="$PWD/dist/fleet/carbideos-${version}"
    update_feed="$PWD/dist/update-feed/fleet"
    output=carbideos-fleet
    secureboot_cert=keys/production/secureboot/secureboot.crt
    trusted_release_pub=keys/production/manifest/release-signing.pub.asc
    feed_extensions="chrome"
    update_prefix=carbideos-fleet
elif [ "$variant" = playground ]; then
    release="$PWD/dist/playground/carbideos-${version}"
    update_feed="$PWD/dist/update-feed/playground"
    output=carbideos-playground
    secureboot_cert=keys/playground/secureboot/secureboot.crt
    trusted_release_pub=keys/playground/manifest/release-signing.pub.asc
    feed_extensions="chrome rat-game-16"
    update_prefix=carbideos-playground
else
    release="$PWD/dist/carbideos-${version}"
    update_feed="$PWD/dist/update-feed"
    output=carbideos
    secureboot_cert=keys/secureboot/secure-boot.crt
    trusted_release_pub=keys/manifest/release-signing.pub.asc
    feed_extensions="chrome rat-game-16"
    update_prefix=carbideos
fi
verify_home=$(mktemp -d)
trap 'rm -rf "$verify_home"' EXIT HUP INT TERM

if [ -e mkosi.extra/usr/lib/carbideos/authorized_keys/ace-mgmt ]; then
    printf '%s\n' 'The source tree must not contain an authorized admin key.' >&2
    exit 1
fi
if [ "$variant" != playground ]; then
    if [ "$(stat -c '%a' keys/admin/ace-mgmt.pub)" -gt 644 ] || \
       { [ "$variant" != fleet ] && \
         [ "$(stat -c '%a' keys/admin/ace-mgmt.password)" -gt 600 ]; }; then
        printf '%s\n' 'Local admin credential inputs have unsafe modes.' >&2
        exit 1
    fi
fi

if ! cmp -s "$trusted_release_pub" "$release/release-signing.pub.asc"; then
    printf '%s\n' 'Packaged release key does not match configured trust.' >&2
    exit 1
fi
if grep -Eq '^(PasswordAuthentication yes|AllowUsers .*ace-bootstrap)' \
    mkosi.extra/etc/ssh/sshd_config.d/10-carbideos.conf; then
    printf '%s\n' 'Production SSH configuration enables a migration login.' >&2
    exit 1
fi
if ! grep -Fq "grep -Fq '\"state\":\"active\"'" \
    mkosi.extra/usr/libexec/carbideos-homed-activate || \
   ! grep -Fqx '        systemd-notify --ready' \
    mkosi.extra/usr/libexec/carbideos-homed-activate || \
   ! grep -Fq 'homectl with ace-mgmt /usr/bin/sleep infinity &' \
    mkosi.extra/usr/libexec/carbideos-homed-activate || \
   ! grep -Fqx 'Type=notify' \
    mkosi.extra/usr/lib/systemd/system/carbideos-homed-activate.service; then
    printf '%s\n' 'Homed activation must retain a boot-long home reference.' >&2
    exit 1
fi
# The enrollment command is matched literally.
# shellcheck disable=SC2016
if ! grep -Fqx 'ExecStart=/usr/sbin/restorecon -RF /home' \
        mkosi.extra/usr/lib/systemd/system/carbideos-home-init.service || \
   ! grep -Fqx '/usr/sbin/restorecon -RF "/home/$username.homedir"' \
        mkosi.extra/usr/libexec/carbideos-playground-enroll; then
    printf '%s\n' 'Homed backing directories must receive SELinux labels.' >&2
    exit 1
fi
if ! grep -qx 'Mode=0600' \
    mkosi.extra/usr/lib/sysupdate.d/90-uki.transfer; then
    printf '%s\n' 'UKI transfer must remain root-writable for boot counting.' >&2
    exit 1
fi
if ! grep -Fq '/usr/bin/bootctl set-oneshot' \
        mkosi.extra/usr/sbin/carbideos-ops || \
   ! grep -Fqx '        /usr/bin/sync' \
        mkosi.extra/usr/sbin/carbideos-ops || \
   ! grep -Fq '/usr/lib/systemd/systemd-sysupdate reboot' \
        mkosi.extra/usr/sbin/carbideos-ops; then
    printf '%s\n' 'Operator updates must explicitly activate through sysupdate.' >&2
    exit 1
fi
if ! grep -Fqx '        panic=30' mkosi.conf || \
   ! grep -Fqx 'RuntimeWatchdogSec=60s' \
        mkosi.extra/etc/systemd/system.conf.d/60-carbideos-watchdog.conf || \
   ! grep -Fqx \
        'ConditionPathExistsGlob=/sys/firmware/efi/efivars/LoaderBootCountPath-*' \
        mkosi.extra/usr/lib/systemd/system/carbideos-counted-boot-reboot.service; then
    printf '%s\n' 'Counted-boot retry and watchdog policy is incomplete.' >&2
    exit 1
fi

GNUPGHOME="$verify_home" gpg --batch --import \
    "$release/release-signing.pub.asc" >/dev/null 2>&1
GNUPGHOME="$verify_home" gpg --batch --verify \
    "$release/SHA256SUMS.asc" "$release/SHA256SUMS"
GNUPGHOME="$verify_home" gpg --batch --verify \
    "$update_feed/SHA256SUMS.gpg" "$update_feed/SHA256SUMS"

(
    cd "$release"
    sha256sum --check --strict SHA256SUMS
)
if ! grep -q '"name": "systemd-container"' \
    "$release/$output.manifest"; then
    printf '%s\n' 'Release is missing systemd-pull (Fedora systemd-container).' >&2
    exit 1
fi
if ! grep -q '"name": "gnupg2"' "$release/$output.manifest"; then
    printf '%s\n' 'Release is missing gpg for signed update verification.' >&2
    exit 1
fi
if ! grep -q '"name": "systemd-pam"' "$release/$output.manifest"; then
    printf '%s\n' 'Release is missing PAM integration for systemd-homed.' >&2
    exit 1
fi
if ! grep -q '"name": "qemu-guest-agent"' "$release/$output.manifest"; then
    printf '%s\n' 'Release is missing QEMU Guest Agent.' >&2
    exit 1
fi
(
    cd "$update_feed"
    sha256sum --check --strict SHA256SUMS
)

for command in jq mdir sbverify sfdisk systemd-dissect zstd; do
    if ! command -v "$command" >/dev/null 2>&1 && \
       [ ! -x "/usr/sbin/$command" ]; then
        printf 'Missing required verification command: %s\n' "$command" >&2
        exit 1
    fi
done
if [ "$variant" = playground ] && \
   ! command -v dump.erofs >/dev/null 2>&1 && \
   [ ! -x /usr/sbin/dump.erofs ]; then
    printf '%s\n' 'Missing required verification command: dump.erofs' >&2
    exit 1
fi
sfdisk=${SFDISK:-$(command -v sfdisk || true)}
[ -n "$sfdisk" ] || sfdisk=/usr/sbin/sfdisk

for pattern in \
    "${update_prefix}_${version}.efi" \
    "${update_prefix}_${version}_"'*.root.raw.zst' \
    "${update_prefix}_${version}_"'*.verity.raw.zst' \
    "${update_prefix}_${version}.verity-sig.raw.zst"; do
    # The patterns intentionally expand to exactly one update artifact.
    # shellcheck disable=SC2086
    set -- "$update_feed"/$pattern
    if [ "$#" -ne 1 ] || [ ! -s "$1" ]; then
        printf 'Missing or ambiguous sysupdate artifact: %s\n' "$pattern" >&2
        exit 1
    fi
done

set -- "$update_feed"/"${update_prefix}_${version}_"*.root.raw.zst
root_artifact=$1
set -- "$update_feed"/"${update_prefix}_${version}_"*.verity.raw.zst
verity_artifact=$1
verity_sig_artifact="$update_feed/${update_prefix}_${version}.verity-sig.raw.zst"
uki_artifact="$update_feed/${update_prefix}_${version}.efi"
for extension_name in $feed_extensions; do
extension_artifact="$update_feed/${extension_name}_${version}.sysext.raw"
if [ ! -s "$extension_artifact" ]; then
    printf 'Missing %s system extension artifact.\n' "$extension_name" >&2
    exit 1
fi
if ! sudo systemd-dissect "$extension_artifact" | grep -q 'signed'; then
    printf '%s is not verity signed.\n' "$extension_name" >&2
    exit 1
fi
signature_start=$("$sfdisk" --json "$extension_artifact" | jq -r \
    '.partitiontable.partitions[] | select(.name == "root-x86-64-verity-sig") | .start')
signature_size=$("$sfdisk" --json "$extension_artifact" | jq -r \
    '.partitiontable.partitions[] | select(.name == "root-x86-64-verity-sig") | .size')
signature_json="$verify_home/sysext-signature.json"
signature_der="$verify_home/sysext-signature.der"
signature_cert="$verify_home/sysext-signature.crt"
root_hash="$verify_home/sysext-root-hash"
if [ -z "$signature_start" ] || [ -z "$signature_size" ]; then
    printf '%s signature partition is missing.\n' "$extension_name" >&2
    exit 1
fi
dd if="$extension_artifact" bs=512 skip="$signature_start" \
    count="$signature_size" status=none | tr -d '\000' >"$signature_json"
jq -r .signature "$signature_json" | base64 -d >"$signature_der"
printf '%s' "$(jq -r .rootHash "$signature_json")" >"$root_hash"
if ! openssl cms -verify -binary -inform DER -in "$signature_der" \
        -content "$root_hash" -CAfile "$secureboot_cert" -purpose any \
        -out /dev/null; then
    printf '%s verity signature is not trusted.\n' "$extension_name" >&2
    exit 1
fi
openssl pkcs7 -inform DER -in "$signature_der" -print_certs \
    -out "$signature_cert"
embedded_fingerprint=$(openssl x509 -in "$signature_cert" -noout \
    -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr '[:upper:]' '[:lower:]')
expected_fingerprint=$(openssl x509 -in "$release/sysext.crt" -noout \
    -fingerprint -sha256 | sed 's/.*=//; s/://g' | tr '[:upper:]' '[:lower:]')
declared_fingerprint=$(jq -r .certificateFingerprint "$signature_json")
if [ "$embedded_fingerprint" != "$expected_fingerprint" ] || \
   [ "$declared_fingerprint" != "$expected_fingerprint" ]; then
    printf '%s signer does not match packaged trust.\n' "$extension_name" >&2
    exit 1
fi
done
if ! sbverify --cert "$secureboot_cert" "$uki_artifact" \
    >/dev/null; then
    printf '%s\n' 'UKI is not signed by the configured Secure Boot key.' >&2
    exit 1
fi
if { [ "$variant" = fleet ] || [ "$variant" = playground ]; } && \
   ! openssl verify -CAfile "$secureboot_cert" "$release/sysext.crt"; then
    printf '%s\n' \
        'System extension certificate is not authorized by Secure Boot trust.' >&2
    exit 1
fi

image="$release/$output.raw.zst"
raw=$(mktemp --suffix=.raw)
trap 'rm -rf "$verify_home" "$raw"' EXIT HUP INT TERM
zstd --long=31 --decompress --stdout "$image" >"$raw"

root_uuid=$("$sfdisk" --part-uuid "$raw" 2 | tr '[:upper:]' '[:lower:]')
verity_uuid=$("$sfdisk" --part-uuid "$raw" 3 | tr '[:upper:]' '[:lower:]')
if [ "$variant" = playground ]; then
    root_offset=$("$sfdisk" --json "$raw" | jq -r \
        '.partitiontable as $t | ($t.partitions[1].start * $t.sectorsize)')
    if ! dump.erofs --offset="$root_offset" \
        --path=/etc/systemd/system/multi-user.target.wants/\
carbideos-playground-enroll.service "$raw" >/dev/null; then
        printf '%s\n' \
            'Playground enrollment is not enabled in the finished image.' >&2
        exit 1
    fi
    for pam_profile in system-auth password-auth; do
        pam_config=$(dump.erofs --cat --offset="$root_offset" \
            --path="/etc/authselect/$pam_profile" "$raw")
        homed_auth_line=$(printf '%s\n' "$pam_config" | grep -n \
            '^-auth .*\[success=done .*pam_systemd_home\.so$' | cut -d: -f1)
        unix_auth_line=$(printf '%s\n' "$pam_config" | grep -n \
            '^auth .*pam_unix\.so' | cut -d: -f1)
        if [ -z "$homed_auth_line" ] || [ -z "$unix_auth_line" ] || \
           [ "$homed_auth_line" -ge "$unix_auth_line" ] || \
           ! printf '%s\n' "$pam_config" | \
                grep -q '^-session .*required pam_systemd_home\.so$'; then
            printf 'Playground %s must activate homed first.\n' \
                "$pam_profile" >&2
            exit 1
        fi
    done
    home_init=$(dump.erofs --cat --offset="$root_offset" \
        --path=/usr/lib/systemd/system/carbideos-home-init.service "$raw")
    enrollment=$(dump.erofs --cat --offset="$root_offset" \
        --path=/usr/libexec/carbideos-playground-enroll "$raw")
    # The enrollment command is matched literally.
    # shellcheck disable=SC2016
    if ! printf '%s\n' "$home_init" | \
            grep -Fqx 'ExecStart=/usr/sbin/restorecon -RF /home' || \
       ! printf '%s\n' "$enrollment" | grep -Fqx \
            '/usr/sbin/restorecon -RF "/home/$username.homedir"'; then
        printf '%s\n' \
            'Finished image does not label homed backing directories.' >&2
        exit 1
    fi
    signature_transfer=$(dump.erofs --cat --offset="$root_offset" \
        --path=/usr/lib/sysupdate.d/10-root-verity-sig.transfer "$raw")
    if ! printf '%s\n' "$signature_transfer" | \
            grep -Fqx 'MatchPattern=carbideos-pg_@v_verity_sig'; then
        printf '%s\n' \
            'Playground signature-slot label exceeds GPT limits.' >&2
        exit 1
    fi
fi
if [ "$(basename "$root_artifact")" != \
    "${update_prefix}_${version}_${root_uuid}.root.raw.zst" ]; then
    printf '%s\n' 'Root artifact filename does not contain its GPT UUID.' >&2
    exit 1
fi
if [ "$(basename "$verity_artifact")" != \
    "${update_prefix}_${version}_${verity_uuid}.verity.raw.zst" ]; then
    printf '%s\n' 'Verity artifact filename does not contain its GPT UUID.' >&2
    exit 1
fi

root_size=$(zstd --long=31 -qdc "$root_artifact" | wc -c)
verity_size=$(zstd --long=31 -qdc "$verity_artifact" | wc -c)
verity_sig_size=$(zstd --long=31 -qdc "$verity_sig_artifact" | wc -c)
if [ "$root_size" -gt $((768 * 1024 * 1024)) ] || \
   [ "$verity_size" -gt $((32 * 1024 * 1024)) ] || \
   [ "$verity_sig_size" -ne $((16 * 1024)) ]; then
    printf '%s\n' 'An update artifact exceeds its inactive partition slot.' >&2
    exit 1
fi

esp_size=$("$sfdisk" --json "$raw" | jq -r \
    '.partitiontable as $t | ($t.partitions[0].size * $t.sectorsize)')
esp_offset=$("$sfdisk" --json "$raw" | jq -r \
    '.partitiontable as $t | ($t.partitions[0].start * $t.sectorsize)')
esp_listing=$(mdir -b -i "$raw@@$esp_offset" ::/EFI/Linux)
if ! printf '%s\n' "$esp_listing" | \
        grep -Fqx "::/EFI/Linux/${update_prefix}_${version}.efi" || \
   printf '%s\n' "$esp_listing" | grep -Fq '%v'; then
    printf '%s\n' \
        'Factory ESP does not contain the expected versioned UKI filename.' >&2
    exit 1
fi
uki_size=$(wc -c <"$uki_artifact")
if [ $((uki_size * 2 + 16 * 1024 * 1024)) -gt "$esp_size" ]; then
    printf '%s\n' 'ESP cannot retain two current-sized UKIs with 16 MiB free.' >&2
    exit 1
fi

if [ "$(id -u)" -eq 0 ]; then
    dissection=$(systemd-dissect "$raw")
elif command -v sudo >/dev/null 2>&1; then
    dissection=$(sudo systemd-dissect "$raw")
else
    printf '%s\n' 'sudo is required for partition metadata inspection.' >&2
    exit 1
fi
printf '%s\n' "$dissection"
if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    expected_id=carbideos-fleet
    expected_variant=fleet
    if [ "$variant" = playground ]; then
        expected_id=carbideos-playground
        expected_variant=playground
    fi
    if ! printf '%s\n' "$dissection" | grep -q "IMAGE_ID=$expected_id" || \
       ! printf '%s\n' "$dissection" | \
            grep -q "VARIANT_ID=$expected_variant"; then
        printf '%s image identity is missing or incorrect.\n' "$variant" >&2
        exit 1
    fi
fi

printf 'Verified CarbideOS %s release.\n' "$version"
