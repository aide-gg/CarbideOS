#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu
umask 077

cd "$(dirname "$0")/.."
variant=development
case "${1-}" in
    '') ;;
    --fleet) variant=fleet ;;
    --playground) variant=playground ;;
    *) printf 'Usage: %s [--fleet|--playground]\n' "$0" >&2; exit 2 ;;
esac

source_tree=${ACE_SOURCE:-../watchtower/ace}
case "$variant" in
    fleet)
        output="$PWD/dist/ace/fleet"
        gnupg="$PWD/keys/production/manifest/gnupg"
        signer='CarbideOS Production Release'
        ;;
    playground)
        output="$PWD/dist/ace/playground"
        gnupg="$PWD/keys/playground/manifest/gnupg"
        signer='CarbideOS Playground Release'
        ;;
    *)
        output="$PWD/dist/ace"
        gnupg="$PWD/keys/manifest/gnupg"
        signer='CarbideOS Development Release'
        ;;
esac

for command in bun cpio gpg sha256sum tar zstd; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Missing required command: %s\n' "$command" >&2
        exit 1
    }
done
[ -s "$source_tree/bun.lock" ] || {
    printf 'ACE source is missing bun.lock: %s\n' "$source_tree" >&2
    exit 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
install -d "$work/ace" "$output"
(
    cd "$source_tree"
    tar \
        --exclude=.git \
        --exclude='.env*' \
        --exclude=node_modules \
        --exclude=logs \
        --exclude=dist \
        --exclude='*.heapsnapshot' \
        --exclude='service-account.json' \
        -cf - .
) | tar -xf - -C "$work/ace"

if find "$work/ace" -type f \( -name '.env*' -o -name 'service-account.json' \) \
        | grep -q .; then
    printf '%s\n' 'Refusing to package ACE credentials.' >&2
    exit 1
fi
if grep -RIE \
        '(rediss?://[^[:space:]]+:[^@[:space:]]+@|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9_-]{20,})' \
        "$work/ace" >/dev/null; then
    printf '%s\n' 'Refusing to package a credential-bearing ACE source file.' >&2
    exit 1
fi

(
    cd "$work/ace"
    bun install --frozen-lockfile --production
)

find "$work/ace" -type d -exec chmod 0755 {} +
find "$work/ace" -type f -perm /u=x -exec chmod 0755 {} +
find "$work/ace" -type f ! -perm /u=x -exec chmod 0644 {} +
epoch=$(git -C "$source_tree" log -1 --format=%ct)
find "$work/ace" -exec touch -h -d "@$epoch" {} +

archive="$output/ace.cpio.zst"
(
    cd "$work"
    find ace -print0 | LC_ALL=C sort -z \
        | cpio --null --create --format=newc --owner=0:0 --reproducible --quiet
) | zstd -15 -T0 -f -o "$archive"
sha256sum "$archive" >"$archive.sha256"

if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    passphrase=${CARBIDEOS_SIGNING_KEY_PASSPHRASE:-}
    [ -n "$passphrase" ] || passphrase=$(systemd-ask-password \
        "CarbideOS $variant signing passphrase:")
    printf '%s\n' "$passphrase" | GNUPGHOME="$gnupg" \
        gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
            --armor --detach-sign --local-user "$signer" \
            --output "$archive.asc" "$archive"
    unset passphrase
else
    GNUPGHOME="$gnupg" gpg --batch --yes --armor --detach-sign \
        --local-user "$signer" --output "$archive.asc" "$archive"
fi

printf 'Packaged signed ACE runtime at %s\n' "$archive"
