#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

cd "$(dirname "$0")/.."

variant=development
case "${1-}" in
    '') ;;
    --debug)
        variant=debug
        ;;
    --fleet)
        variant=fleet
        ;;
    --playground)
        variant=playground
        ;;
    *)
        printf 'Usage: %s [--debug|--fleet|--playground]\n' "$0" >&2
        exit 2
        ;;
esac
if [ "$#" -gt 1 ]; then
    printf 'Usage: %s [--debug|--fleet|--playground]\n' "$0" >&2
    exit 2
fi
# mkosi.version is a file in the working tree, so a build takes whatever it
# says at the moment it starts. Two builds run in parallel, or one started
# while the file is being bumped for another, silently produce an image
# stamped with someone else's version: a fleet build once came out as 0.1.46
# because a development version was mid-flight. Naming the version explicitly
# makes a build independent of the tree's current state.
# One build at a time. mkosi resolves the image version from mkosi.version and
# honours no override, so the file is the only way to name a version and two
# builds sharing this checkout will label each other's images. A fleet build
# came out stamped 0.1.46 that way, while a development version was mid-flight.
# Held by the unprivileged half only. This script re-executes itself under
# sudo, and sudo does not carry the descriptor across, so taking the lock on
# both halves would make every build wait on itself.
if [ "$(id -u)" -ne 0 ]; then
    exec 9>.mkosi-build.lock
    if ! flock --exclusive --nonblock 9; then
        printf '%s\n' 'Another CarbideOS build is running in this checkout.' >&2
        printf '%s\n' 'Wait for it to finish: they share mkosi.version.' >&2
        exit 1
    fi
fi

version=${CARBIDEOS_VERSION:-$(tr -d '[:space:]' <mkosi.version)}
case "$version" in
    '' | *[!A-Za-z0-9._-]*)
        printf 'Refusing to build version %s\n' "$version" >&2
        exit 1
        ;;
esac
# Kept in step deliberately, because mkosi reads this file rather than anything
# passed to it, so a version named on the command line has to land here to have
# any effect at all.
if [ "$(id -u)" -ne 0 ]; then
    printf '%s\n' "$version" >mkosi.version
    printf 'Building CarbideOS %s (%s)\n' "$version" "$variant"
fi

case "$variant" in
    fleet)
        secureboot_key=keys/production/secureboot/secureboot.key
        secureboot_cert=keys/production/secureboot/secureboot.crt
        verity_key=keys/production/verity/verity.key
        verity_cert=keys/production/verity/verity.crt
        release_pub=keys/production/manifest/release-signing.pub.asc
        admin_group=carbide-operator
        output=carbideos-fleet
        ;;
    playground)
        secureboot_key=keys/playground/secureboot/secureboot.key
        secureboot_cert=keys/playground/secureboot/secureboot.crt
        verity_key=keys/playground/verity/verity.key
        verity_cert=keys/playground/verity/verity.crt
        release_pub=keys/playground/manifest/release-signing.pub.asc
        admin_group=carbide-operator
        output=carbideos-playground
        ;;
    debug)
        secureboot_key=keys/secureboot/secure-boot.key
        secureboot_cert=keys/secureboot/secure-boot.crt
        verity_key=keys/verity/verity.key
        verity_cert=keys/verity/verity.crt
        release_pub=keys/manifest/release-signing.pub.asc
        admin_group=wheel,carbide-operator
        output=carbideos-debug
        ;;
    development)
        secureboot_key=keys/secureboot/secure-boot.key
        secureboot_cert=keys/secureboot/secure-boot.crt
        verity_key=keys/verity/verity.key
        verity_cert=keys/verity/verity.crt
        release_pub=keys/manifest/release-signing.pub.asc
        admin_group=wheel,carbide-operator
        output=carbideos
        ;;
esac

if [ "$variant" = development ] || [ "$variant" = debug ]; then
    if [ ! -s keys/secureboot/secure-boot.key ] || \
       [ ! -s keys/verity/verity.key ] || \
       [ ! -s keys/manifest/release-signing.pub.asc ] || \
       [ ! -s keys/admin/ace-mgmt.pub ] || \
       [ ! -s keys/admin/ace-mgmt.password ]; then
        ./scripts/provision-keys
    fi
fi

for file in \
    "$secureboot_key" \
    "$secureboot_cert" \
    "$verity_key" \
    "$verity_cert" \
    "$release_pub"; do
    if [ ! -s "$file" ]; then
        printf 'Missing %s; run make keys first.\n' "$file" >&2
        exit 1
    fi
done

if [ "$variant" != playground ] && [ ! -s keys/admin/ace-mgmt.pub ]; then
    printf '%s\n' 'Missing keys/admin/ace-mgmt.pub.' >&2
    exit 1
fi

if [ "$variant" != fleet ] && [ "$variant" != playground ] && \
   [ ! -s keys/admin/ace-mgmt.password ]; then
    printf '%s\n' 'Missing keys/admin/ace-mgmt.password.' >&2
    exit 1
fi

if [ "$(stat -c '%a' "$secureboot_key")" -gt 600 ] || \
   [ "$(stat -c '%a' "$verity_key")" -gt 600 ]; then
    printf '%s\n' 'Private signing keys must not be group/world accessible.' >&2
    exit 1
fi

if [ "$variant" != fleet ] && [ "$variant" != playground ] && \
   [ "$(stat -c '%a' keys/admin/ace-mgmt.password)" -gt 600 ]; then
    printf '%s\n' 'The admin password file must not be group/world accessible.' >&2
    exit 1
fi

# carbide-agent is compiled on the host and installed into the image further
# down. Resolve cargo before elevating, because root's PATH will not include a
# per-user Rust toolchain.
if [ -z "${CARGO:-}" ]; then
    CARGO=$(command -v cargo 2>/dev/null || true)
    if [ -z "$CARGO" ] && [ -x "$HOME/.cargo/bin/cargo" ]; then
        CARGO="$HOME/.cargo/bin/cargo"
    fi
fi
if [ -z "${CARGO:-}" ] || [ ! -x "$CARGO" ]; then
    printf '%s\n' 'Missing cargo; required to build carbide-agent.' >&2
    exit 1
fi
export CARGO

agent_binary=agent/target/release/carbide-agent

if [ "$(id -u)" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        printf '%s\n' 'Building an enforcing SELinux image requires root.' >&2
        exit 1
    fi
    # Compile before elevating. A rustup-managed toolchain resolves through a
    # shim that reads the invoking user's configuration, which root does not
    # have, and building as root would leave root-owned artifacts behind.
    "$CARGO" build --release --locked --manifest-path agent/Cargo.toml
    printf '%s\n' 'Elevating mkosi so Fedora SELinux labels can be applied.'
    if [ -n "${CARBIDEOS_SIGNING_KEY_PASSPHRASE:-}" ]; then
        exec sudo --preserve-env=CARGO,CARBIDEOS_SIGNING_KEY_PASSPHRASE \
            "$PWD/scripts/build" "$@"
    fi
    exec sudo --preserve-env=CARGO "$PWD/scripts/build" "$@"
fi

# Reached only as root. The build above normally supplies this; invoking the
# script directly as root is the exception rather than the path.
if [ ! -x "$agent_binary" ]; then
    "$CARGO" build --release --locked --manifest-path agent/Cargo.toml
fi

# Replace only CarbideOS artifacts. Keep mkosi.output/tools so the large Debian
# tools environment is reused across image rebuilds.
if [ -d mkosi.output ]; then
    find mkosi.output -maxdepth 1 \( -type f -o -type l \) \
        -name "$output.*" -delete
fi

extra=$(mktemp -d)
private_work=
cleanup() {
    rm -rf "$extra"
    [ -z "$private_work" ] || rm -rf "$private_work"
}
trap cleanup EXIT HUP INT TERM

if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    passphrase=${CARBIDEOS_SIGNING_KEY_PASSPHRASE:-}
    if [ -z "$passphrase" ]; then
        display_variant=$variant
        passphrase=$(systemd-ask-password \
            "CarbideOS $display_variant signing passphrase:")
    fi
    private_work=$(mktemp -d)
    chmod 0700 "$private_work"
    export CARBIDEOS_SIGNING_KEY_PASSPHRASE="$passphrase"
    openssl pkey -in "$secureboot_key" \
        -passin env:CARBIDEOS_SIGNING_KEY_PASSPHRASE \
        -out "$private_work/secureboot.key"
    openssl pkey -in "$verity_key" \
        -passin env:CARBIDEOS_SIGNING_KEY_PASSPHRASE \
        -out "$private_work/verity.key"
    chmod 0600 "$private_work"/*.key
    secureboot_key="$private_work/secureboot.key"
    verity_key="$private_work/verity.key"
    unset CARBIDEOS_SIGNING_KEY_PASSPHRASE passphrase
fi
# carbide-agent ships inside the sealed image, so it is covered by A/B rollback
# and survives whatever happens to a system extension.
install -D -m 0755 "$agent_binary" "$extra/usr/bin/carbide-agent"

install -d -m 0755 "$extra/usr/lib/carbideos/authorized_keys"
if [ "$variant" != playground ]; then
    install -m 0644 keys/admin/ace-mgmt.pub \
        "$extra/usr/lib/carbideos/authorized_keys/ace-mgmt"
fi
# A comma separated list, because development images keep wheel for a human
# while also joining carbide-operator, so the command broker behaves exactly as
# it does on a fleet node. Divergence here is how a fleet-only failure hides
# behind a passing development test.
printf '%s\n' "$admin_group" >"$extra/usr/lib/carbideos/admin-group"
install -d -m 0755 "$extra/usr/share/carbideos"
gpg --batch --dearmor <"$release_pub" | base64 -w 0 \
    >"$extra/usr/share/carbideos/import-pubring.pgp.b64"
printf '\n' >>"$extra/usr/share/carbideos/import-pubring.pgp.b64"
if [ "$variant" != fleet ] && [ "$variant" != playground ]; then
    install -m 0600 keys/admin/ace-mgmt.password \
        "$extra/usr/lib/carbideos/ace-mgmt.password"
fi
if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    if [ "$variant" = fleet ]; then
        channel=fleet
        prefix=carbideos-fleet
    else
        channel=playground
        prefix=carbideos-playground
        install -d -m 0755 "$extra/usr/lib/systemd/system-preset"
        printf '%s\n' 'enable carbideos-playground-enroll.service' \
            >"$extra/usr/lib/systemd/system-preset/01-carbideos-playground.preset"
    fi
    install -d -m 0755 \
        "$extra/usr/lib/sysupdate.d" \
        "$extra/usr/sbin"
    for transfer in mkosi.extra/usr/lib/sysupdate.d/*.transfer; do
        destination="$extra/usr/lib/sysupdate.d/$(basename "$transfer")"
        sed \
            -e "s|https://updates.aide.gg/carbideos|https://updates.aide.gg/carbideos/$channel|g" \
            -e "s/carbideos_/${prefix}_/g" \
            "$transfer" >"$destination"
        if [ "$variant" = playground ] && \
           [ "$(basename "$transfer")" = 10-root-verity-sig.transfer ]; then
            sed -i \
                's/carbideos-playground_@v_verity_sig/carbideos-pg_@v_verity_sig/' \
                "$destination"
        fi
    done
    # Named sysupdate components — one directory per acquirable extension.
    #
    # Only the channel is rewritten. The base image is published under a
    # per-variant name, but an extension image is not: chrome_0.1.58.sysext.raw
    # is the same file name in every channel, so applying the prefix rewrite
    # here would point the transfer at something that was never published.
    for component in mkosi.extra/usr/lib/sysupdate.*.d; do
        [ -d "$component" ] || continue
        component_directory="$extra/usr/lib/$(basename "$component")"
        install -d -m 0755 "$component_directory"
        for transfer in "$component"/*.transfer; do
            [ -f "$transfer" ] || continue
            sed \
                -e "s|https://updates.aide.gg/carbideos|https://updates.aide.gg/carbideos/$channel|g" \
                "$transfer" >"$component_directory/$(basename "$transfer")"
        done
    done
    sed "s|https://updates.aide.gg/carbideos/|https://updates.aide.gg/carbideos/$channel/|g" \
        mkosi.extra/usr/sbin/carbideos-extension \
        >"$extra/usr/sbin/carbideos-extension"
    chmod 0755 "$extra/usr/sbin/carbideos-extension"
fi

if [ "$variant" = debug ]; then
    printf '%s\n' 'Building CarbideOS debug image with root password enabled.'
    mkosi --extra-tree="$extra" \
        --output=carbideos-debug --hostname=carbideos-debug \
        --unified-kernel-image-format="carbideos-debug_${version}" \
        --environment=CARBIDEOS_VARIANT=debug build

    debug_release=dist/debug
    install -d "$debug_release"
    cp --preserve=mode,timestamps mkosi.output/carbideos-debug.raw.zst \
        "$debug_release/"
    (
        cd "$debug_release"
        sha256sum carbideos-debug.raw.zst >SHA256SUMS
    )
    if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
        chown -R "$SUDO_UID:$SUDO_GID" "$debug_release"
    fi
    printf 'Published CarbideOS debug image in %s\n' "$debug_release"
    exit 0
fi

if [ "$variant" = fleet ]; then
    printf '%s\n' 'Building CarbideOS fleet image with production trust.'
    mkosi --extra-tree="$extra" \
        --output="$output" --image-id=carbideos-fleet --hostname=carbideos \
        --unified-kernel-image-format="carbideos-fleet_${version}" \
        --environment=CARBIDEOS_VARIANT=fleet \
        --secure-boot-key="$secureboot_key" \
        --secure-boot-certificate="$secureboot_cert" \
        --verity-key="$verity_key" \
        --verity-certificate="$verity_cert" build
elif [ "$variant" = playground ]; then
    printf '%s\n' 'Building CarbideOS Playground image with isolated trust.'
    mkosi --extra-tree="$extra" \
        --output="$output" --image-id=carbideos-playground \
        --hostname=carbideos-playground \
        --unified-kernel-image-format="carbideos-playground_${version}" \
        --environment=CARBIDEOS_VARIANT=playground \
        --secure-boot-key="$secureboot_key" \
        --secure-boot-certificate="$secureboot_cert" \
        --verity-key="$verity_key" \
        --verity-certificate="$verity_cert" build
else
    mkosi --extra-tree="$extra" \
        --unified-kernel-image-format="carbideos_${version}" \
        --environment=CARBIDEOS_VARIANT=development build
fi
