#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

cd "$(dirname "$0")/.."

vmid=${1:-${PROXMOX_VMID:-}}
wanted=${2:-running}
timeout=${3:-60}
if [ -z "$vmid" ]; then
    printf 'Usage: %s VMID running|stopped [TIMEOUT_SECONDS]\n' "$0" >&2
    exit 2
fi
case "$wanted" in running|stopped) ;; *) exit 2 ;; esac

if [ -f .env.proxmox ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env.proxmox
    set +a
fi
case "${PROXMOX_HOST:-}" in
    http://*|https://*) base=${PROXMOX_HOST%/} ;;
    ?*) base="https://${PROXMOX_HOST}:8006" ;;
    *) printf '%s\n' 'Missing PROXMOX_HOST.' >&2; exit 2 ;;
esac
case "$base" in
    */api2/json) ;;
    *) base="$base/api2/json" ;;
esac
auth="Authorization: PVEAPIToken=${PROXMOX_USER}!${PROXMOX_TOKEN_NAME}=${PROXMOX_TOKEN_SECRET}"
node=${PROXMOX_NODE:-Prox-PC}
deadline=$(( $(date +%s) + timeout ))

while [ "$(date +%s)" -lt "$deadline" ]; do
    state=$(curl -kfsS -H "$auth" \
        "$base/nodes/$node/qemu/$vmid/status/current" | jq -r '.data.status')
    if [ "$state" = "$wanted" ]; then
        printf 'VM %s is %s.\n' "$vmid" "$wanted"
        exit 0
    fi
    sleep 1
done

printf 'Timed out waiting for VM %s to become %s after %s seconds.\n' \
    "$vmid" "$wanted" "$timeout" >&2
exit 1
