#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

cd "$(dirname "$0")/.."

passphrase=$(systemd-ask-password \
    'CarbideOS Playground signing passphrase:')
if [ -z "$passphrase" ]; then
    printf '%s\n' 'The Playground signing passphrase cannot be empty.' >&2
    exit 1
fi
export CARBIDEOS_SIGNING_KEY_PASSPHRASE="$passphrase"
cleanup() {
    unset CARBIDEOS_SIGNING_KEY_PASSPHRASE passphrase
}
trap cleanup EXIT HUP INT TERM

./scripts/build --playground
./extensions/rat-game-16/build --playground
./scripts/package --playground
./scripts/sign --playground
./scripts/verify --playground
