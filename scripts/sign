#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

cd "$(dirname "$0")/.."
variant=development
case "${1-}" in
    '') ;;
    --fleet) variant=fleet ;;
    --playground) variant=playground ;;
    *) printf 'Usage: %s [--fleet|--playground]\n' "$0" >&2; exit 2 ;;
esac
version=$(tr -d '[:space:]' <mkosi.version)
if [ "$variant" = fleet ]; then
    release="$PWD/dist/fleet/carbideos-${version}"
    update_feed="$PWD/dist/update-feed/fleet"
    gnupg="$PWD/keys/production/manifest/gnupg"
    signer='CarbideOS Production Release'
elif [ "$variant" = playground ]; then
    release="$PWD/dist/playground/carbideos-${version}"
    update_feed="$PWD/dist/update-feed/playground"
    gnupg="$PWD/keys/playground/manifest/gnupg"
    signer='CarbideOS Playground Release'
else
    release="$PWD/dist/carbideos-${version}"
    update_feed="$PWD/dist/update-feed"
    gnupg="$PWD/keys/manifest/gnupg"
    signer='CarbideOS Development Release'
fi

if [ ! -d "$release" ]; then
    printf '%s\n' 'No packaged release found; run make package first.' >&2
    exit 1
fi
if [ ! -d "$update_feed" ]; then
    printf '%s\n' 'No update feed found; run make package first.' >&2
    exit 1
fi

(
    cd "$release"
    find . -maxdepth 1 -type f ! -name 'SHA256SUMS*' -printf '%P\n' \
        | LC_ALL=C sort \
        | xargs -r sha256sum >SHA256SUMS
)

(
    cd "$update_feed"
    find . -maxdepth 1 -type f ! -name 'SHA256SUMS*' -printf '%P\n' \
        | LC_ALL=C sort \
        | xargs -r sha256sum >SHA256SUMS
)
if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    passphrase=${CARBIDEOS_SIGNING_KEY_PASSPHRASE:-}
    if [ -z "$passphrase" ]; then
        passphrase=$(systemd-ask-password \
            "CarbideOS $variant signing passphrase:")
    fi
    printf '%s\n' "$passphrase" | GNUPGHOME="$gnupg" \
        gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
            --armor --detach-sign --local-user "$signer" \
            --output "$release/SHA256SUMS.asc" "$release/SHA256SUMS"
    printf '%s\n' "$passphrase" | GNUPGHOME="$gnupg" \
        gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
            --detach-sign --local-user "$signer" \
            --output "$update_feed/SHA256SUMS.gpg" \
            "$update_feed/SHA256SUMS"
    unset passphrase
else
    GNUPGHOME="$gnupg" gpg --batch --yes --armor --detach-sign \
        --local-user "$signer" \
        --output "$release/SHA256SUMS.asc" "$release/SHA256SUMS"
    GNUPGHOME="$gnupg" gpg --batch --yes --detach-sign \
        --local-user "$signer" \
        --output "$update_feed/SHA256SUMS.gpg" "$update_feed/SHA256SUMS"
fi

printf 'Signed release manifest: %s/SHA256SUMS.asc\n' "$release"
printf 'Signed sysupdate manifest: %s/SHA256SUMS.gpg\n' "$update_feed"
