#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu
umask 022

cd "$(dirname "$0")/../.."
if [ "$(id -u)" -ne 0 ]; then
    exec sudo --preserve-env=CARBIDEOS_SIGNING_KEY_PASSPHRASE,CARBIDEOS_EXTENSION_VERSION \
        "$PWD/extensions/chrome/build" "$@"
fi
variant=development
case "${1-}" in
    '') ;;
    --fleet) variant=fleet ;;
    --playground) variant=playground ;;
    *) printf 'Usage: %s [--fleet|--playground]\n' "$0" >&2; exit 2 ;;
esac

version=${CARBIDEOS_EXTENSION_VERSION:-$(tr -d '[:space:]' <mkosi.version)}
chrome_url=https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm
google_key_url=https://dl.google.com/linux/linux_signing_key.pub

case "$variant" in
    fleet)
        output="$PWD/dist/extensions/fleet/chrome"
        signing_key=keys/production/sysext/sysext.key
        signing_cert=keys/production/sysext/sysext.crt
        ;;
    playground)
        output="$PWD/dist/extensions/playground/chrome"
        signing_key=keys/playground/sysext/sysext.key
        signing_cert=keys/playground/sysext/sysext.crt
        ;;
    *)
        output="$PWD/dist/extensions/chrome"
        signing_key=keys/secureboot/secure-boot.key
        signing_cert=keys/secureboot/secure-boot.crt
        ;;
esac

for command in curl jq mkfs.erofs mkosi openssl rpm rpmkeys sha256sum systemd-repart; do
    command -v "$command" >/dev/null 2>&1 || {
        printf 'Missing required command: %s\n' "$command" >&2
        exit 1
    }
done
for file in "$signing_key" "$signing_cert"; do
    [ -s "$file" ] || { printf 'Missing %s\n' "$file" >&2; exit 1; }
done

# Scratch goes on disk, not in /tmp. These images are over a gigabyte each and
# /tmp is tmpfs here, so the default would expand them into RAM and starve
# anything else building at the same time.
#
# Some of these builds run under sudo and some do not, so the directory is
# sticky and world writable exactly as /tmp is. Without that, whichever build
# ran first would own it and lock the other one out. mktemp still creates
# private subdirectories inside, so nothing is shared between users.
: "${TMPDIR:=$PWD/dist/scratch}"
export TMPDIR
mkdir -p "$TMPDIR" 2>/dev/null || :
chmod 1777 "$TMPDIR" 2>/dev/null || :
[ -w "$TMPDIR" ] || {
    printf 'Scratch directory %s is not writable\n' "$TMPDIR" >&2
    exit 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
if [ "$variant" = fleet ] || [ "$variant" = playground ]; then
    passphrase=${CARBIDEOS_SIGNING_KEY_PASSPHRASE:-}
    [ -n "$passphrase" ] || passphrase=$(systemd-ask-password \
        "CarbideOS $variant signing passphrase:")
    export CARBIDEOS_SIGNING_KEY_PASSPHRASE="$passphrase"
    openssl pkey -in "$signing_key" \
        -passin env:CARBIDEOS_SIGNING_KEY_PASSPHRASE \
        -out "$work/sysext.key"
    chmod 0600 "$work/sysext.key"
    signing_key="$work/sysext.key"
    unset CARBIDEOS_SIGNING_KEY_PASSPHRASE passphrase
fi

chrome_rpm="$work/google-chrome.rpm"
curl -LfsS "$chrome_url" -o "$chrome_rpm"

rpmdb="$work/rpmdb"
install -d "$rpmdb" "$output"
curl -LfsS "$google_key_url" -o "$work/google-linux-signing-key.pub"
rpm --dbpath "$rpmdb" --initdb
rpmkeys --dbpath "$rpmdb" --import "$work/google-linux-signing-key.pub"
rpmkeys --dbpath "$rpmdb" --checksig "$chrome_rpm" | grep -q 'digests signatures OK$'
# Whatever Google currently ships, taken only after its signature checks out.
# Pinning a version bought nothing here: the signature is what says the bytes
# are Google's, and holding a browser back is worse than moving with it.
chrome_version=$(rpm -qp --qf '%{VERSION}-%{RELEASE}' "$chrome_rpm")
[ -n "$chrome_version" ] || {
    printf '%s\n' 'Could not read the Chrome version from the package' >&2
    exit 1
}
printf 'Chrome %s\n' "$chrome_version"

project="$work/mkosi"
install -d "$project"
cat >"$project/mkosi.conf" <<EOF
[Distribution]
Distribution=fedora
Release=44

[Output]
Format=directory
Output=root
OutputDirectory=../staging

[Content]
# Chrome's runtime dependencies. dnf resolves the transitive closure, which is
# where most of the image comes from and where anything worth trimming lives.
#
# Trimming it by dependency scan does not work. Chrome dlopens GTK by name
# rather than linking it, so GTK and everything under it reads as unreferenced
# while being entirely live: gdk_pixbuf pulls glycin, which pulls an image
# codec stack. Removing that on the strength of a readelf sweep breaks Chrome's
# own rendering in a way headless testing never shows.
Packages=alsa-lib
         at-spi2-atk
         at-spi2-core
         cairo
         cups-libs
         dbus-libs
         expat
         glib2
         gtk3
         liberation-fonts
         libcurl
         libX11
         libxcb
         libXcomposite
         libXdamage
         libXext
         libXfixes
         libxkbcommon
         libXrandr
         mesa-libgbm
         nspr
         nss
         pango
         systemd-libs
         vulkan-loader
WithDocs=no
CleanPackageMetadata=yes
EOF
mkosi -C "$project" build
installroot="$work/staging/root"
rpm --root "$installroot" --nodeps --noscripts -i "$chrome_rpm"

root="$work/root"
install -d "$root"
[ -d "$installroot/usr" ] && cp -a "$installroot/usr" "$root/"
[ -d "$installroot/opt" ] && cp -a "$installroot/opt" "$root/"

# Files already supplied by this exact CarbideOS build must not be shadowed by
# the extension. Keep only Chrome and packages absent from the base manifest.
case "$variant" in
    fleet) base_manifest=mkosi.output/carbideos-fleet.manifest ;;
    playground) base_manifest=mkosi.output/carbideos-playground.manifest ;;
    *) base_manifest=mkosi.output/carbideos.manifest ;;
esac
[ -s "$base_manifest" ] || {
    printf 'Missing base image manifest: %s\n' "$base_manifest" >&2
    exit 1
}
jq -r '.packages[] | select(.type == "rpm") | .name' "$base_manifest" \
    | while IFS= read -r package; do
        rpm --root "$installroot" -q "$package" >/dev/null 2>&1 || continue
        rpm --root "$installroot" -ql "$package" \
            | while IFS= read -r path; do
                [ -d "$root$path" ] || rm -f "$root$path"
            done
    done

# Drop what a browser automation image never reads. Chrome renders DeltaMath
# identically without any of it, checked by screenshot.
#
# Deliberately kept: WidevineCdm. Its absence is a bot-detection signal, since
# real Chrome has it and Chromium builds mostly do not, and 21 MiB is not worth
# looking less like a browser.
#
# Chrome ships 220 UI translations at 50 MiB; en-US is 0.6 MiB of that. These
# are its own menu strings and have no bearing on navigator.languages or
# Accept-Language, which come from flags.
find "$root/opt/google/chrome/locales" -type f ! -name 'en-US.pak' -delete 2>/dev/null || :
# The closed half of Chrome's Optimization Guide: remote page-load hints and
# on-device model execution. Loaded by dlopen rather than linked, absent from
# DT_NEEDED, and nothing reachable from a page can observe it. Removing it also
# forecloses the on-device model ever downloading itself onto the state
# partition.
rm -f "$root/opt/google/chrome/liboptimization_guide_internal.so"
# Enterprise policy daemon, never started here.
rm -f "$root/opt/google/chrome/chrome-management-service"
# Data, not code: gettext catalogues for every package in the dependency
# closure, manuals, and the IEEE hardware vendor database.
rm -rf "$root/usr/share/locale" "$root/usr/share/man" "$root/usr/share/doc"
rm -f "$root/usr/share/hwdata/oui.txt"
# Python arrived through the dependency closure and nothing here links it
# except itself. Chrome embeds no interpreter.
#
# Deliberately left in place: glycin, libheif, libaom, SvtAv1Enc, libjxl and
# libhwy. They look like the same kind of spill and are not: gdk_pixbuf links
# glycin, and Chrome dlopens GTK by name, so that chain is live whenever it
# runs headful. Clearing those needs a headful smoke test on a node, not a
# dependency scan, which reads dlopen as unreferenced.
rm -f "$root/usr/lib64/libpython3."*".so"* "$root/usr/lib64/libpython3.so"
rm -f "$root/usr/bin/python3."* "$root/usr/bin/python3"

find "$root/usr" -depth -type d -empty -delete
install -d "$root/usr/bin" "$root/usr/lib/extension-release.d"
rm -f "$root/usr/lib/os-release"
rm -f "$root/usr/bin/google-chrome"
ln -s /opt/google/chrome/google-chrome "$root/usr/bin/google-chrome"
cat >"$root/usr/lib/extension-release.d/extension-release.chrome" <<EOF
ID=carbideos
VERSION_ID=$version
ARCHITECTURE=x86-64
SYSEXT_ID=chrome
SYSEXT_VERSION_ID=$chrome_version
EOF

epoch=$(rpm -qp --qf '%{BUILDTIME}' "$chrome_rpm")
find "$root" -exec touch -h -d "@$epoch" {} +
mkfs.erofs --quiet --all-root --all-time -T "$epoch" \
    -L chrome -zlz4hc,level=12 \
    --file-contexts=extensions/chrome/file-contexts \
    "$work/root.erofs" "$root"

# Sized to what it holds. A partition with no maximum grows to fill whatever
# the image has spare, so a fixed --size was split between the data and its
# hash tree rather than sized to either. The tree is one SHA256 per 4 KiB
# block, about data/127; a sixty-fourth plus a megabyte is roughly double that.
erofs_bytes=$(stat -c%s "$work/root.erofs")
verity_bytes=$(( erofs_bytes / 64 + 1024 * 1024 ))
image_bytes=$(( erofs_bytes + verity_bytes + 16384 + 2 * 1024 * 1024 ))
image_mib=$(( (image_bytes + 1048575) / 1048576 ))

definitions="$work/repart.d"
install -d "$definitions"
cat >"$definitions/10-root.conf" <<EOF
[Partition]
Type=root
CopyBlocks=$work/root.erofs
Verity=data
VerityMatchKey=root
ReadOnly=yes
SizeMinBytes=$erofs_bytes
SizeMaxBytes=$erofs_bytes
EOF
cat >"$definitions/20-root-verity.conf" <<EOF
[Partition]
Type=root-verity
Verity=hash
VerityMatchKey=root
ReadOnly=yes
SizeMaxBytes=$verity_bytes
EOF
cat >"$definitions/30-root-verity-sig.conf" <<EOF
[Partition]
Type=root-verity-sig
Verity=signature
VerityMatchKey=root
ReadOnly=yes
EOF
rm -f "$output/chrome.raw"
systemd-repart --empty=create --size="${image_mib}M" \
    --seed=4d8ec194-c9a5-4911-a1ba-37259165044c \
    --definitions="$definitions" \
    --private-key="$signing_key" \
    --certificate="$signing_cert" \
    "$output/chrome.raw"

# The merge enforces this, so a hash tree that did not fit its bound should
# fail here rather than on a node, where it would simply refuse to merge.
systemd-dissect --validate \
    --image-policy=root=verity+signed+absent:usr=verity+signed+absent \
    "$output/chrome.raw" >/dev/null
(
    cd "$output"
    sha256sum chrome.raw >SHA256SUMS
)
if [ -n "${SUDO_UID:-}" ] && [ -n "${SUDO_GID:-}" ]; then
    chown -R "$SUDO_UID:$SUDO_GID" "$output"
fi
printf 'Built Chrome %s sysext for CarbideOS %s in %s\n' \
    "$chrome_version" "$version" "$output"
