#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

if [ "${container:-}" != mkosi ]; then
    exec mkosi-chroot "$CHROOT_SCRIPT" "$@"
fi

sed -i "s/@IMAGE_VERSION@/$IMAGE_VERSION/g" /usr/lib/os-release
variant=${CARBIDEOS_VARIANT:-development}
case "$variant" in
    fleet)
        sed -i \
            -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"CarbideOS $IMAGE_VERSION (Fleet)\"/" \
            -e 's/^IMAGE_ID=.*/IMAGE_ID=carbideos-fleet/' \
            /usr/lib/os-release
        printf '%s\n' 'VARIANT="Fleet"' 'VARIANT_ID=fleet' \
            >>/usr/lib/os-release
        ;;
    debug)
        sed -i \
            -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"CarbideOS $IMAGE_VERSION (Debug)\"/" \
            -e 's/^IMAGE_ID=.*/IMAGE_ID=carbideos-debug/' \
            /usr/lib/os-release
        printf '%s\n' 'VARIANT="Debug"' 'VARIANT_ID=debug' \
            >>/usr/lib/os-release
        ;;
    playground)
        sed -i \
            -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"CarbideOS $IMAGE_VERSION (Playground)\"/" \
            -e 's/^IMAGE_ID=.*/IMAGE_ID=carbideos-playground/' \
            /usr/lib/os-release
        printf '%s\n' 'VARIANT="Playground"' 'VARIANT_ID=playground' \
            >>/usr/lib/os-release
        ;;
    development) ;;
    *)
        printf 'Unknown CarbideOS build variant: %s\n' "$variant" >&2
        exit 1
        ;;
esac
base64 -d /usr/share/carbideos/import-pubring.pgp.b64 \
    >/usr/lib/systemd/import-pubring.pgp

# NvPCR policies are not used yet. Leaving Fedora's defaults installed makes
# systemd-tpm2-setup persist an unnecessary anchor credential to the ESP.
rm -f /usr/lib/nvpcr/*.nvpcr
checkmodule -M -m -o /tmp/carbideos_boot.mod \
    /usr/share/selinux/packages/carbideos-boot.te
semodule_package -o /tmp/carbideos_boot.pp -m /tmp/carbideos_boot.mod
semodule -i /tmp/carbideos_boot.pp
rm -f /tmp/carbideos_boot.mod /tmp/carbideos_boot.pp

# Keep the guard and the original coreutils implementation in immutable /usr.
mv /usr/bin/rm /usr/libexec/carbideos-rm.real
ln -s ../libexec/carbideos-rm /usr/bin/rm
chmod 0440 /etc/sudoers.d/50-carbideos-operator

if [ "$variant" = debug ]; then
    password=$(cat /usr/lib/carbideos/ace-mgmt.password)
    printf 'root:%s\n' "$password" | chpasswd
    unset password
else
    passwd --lock root
fi

if [ "$variant" = playground ]; then
    # Fedora checks pam_unix before homed and treats home activation as
    # optional. Require homed authentication and its mount before tty login.
    for pam_profile in system-auth password-auth; do
        profile="/usr/share/authselect/default/local/$pam_profile"
        sed -i '/pam_systemd_home\.so.*with-systemd-homed/d' "$profile"
        sed -i \
            '/auth .*pam_unix\.so/i\-auth       [success=done authtok_err=bad perm_denied=bad maxtries=bad default=ignore] pam_systemd_home.so {include if "with-systemd-homed"}' \
            "$profile"
        sed -i \
            '/account .*pam_unix\.so/i\-account    [success=done authtok_expired=bad new_authtok_reqd=bad maxtries=bad acct_expired=bad default=ignore] pam_systemd_home.so {include if "with-systemd-homed"}' \
            "$profile"
        sed -i \
            '/password .*pam_pwquality\.so/i\-password   sufficient pam_systemd_home.so {include if "with-systemd-homed"}' \
            "$profile"
        sed -i \
            '/-session .*pam_systemd\.so/i\-session    required pam_systemd_home.so {include if "with-systemd-homed"}' \
            "$profile"
    done
fi
authselect enable-feature with-systemd-homed

systemctl enable sshd.service systemd-homed.service systemd-networkd.service \
    systemd-resolved.service systemd-userdbd.socket \
    systemd-sysext.service qemu-guest-agent.service \
    carbideos-home-init.service carbideos-homed-activate.service \
    carbideos-repart.service \
    carbideos-sshd-keygen.service carbideos-var-init.service home.mount \
    var.mount var-lib-carbideos-workload.mount
if [ "$variant" = playground ]; then
    systemctl disable sshd.service carbideos-homed-activate.service \
        carbideos-sshd-keygen.service
    systemctl mask sshd.service carbideos-homed-activate.service \
        carbideos-sshd-keygen.service
    systemctl enable carbideos-playground-enroll.service
fi
systemctl mask systemd-homed-firstboot.service ssh-host-keys-migration.service \
    sshd-keygen@.service systemd-pcrproduct.service getty@tty2.service \
    getty@tty3.service getty@tty4.service getty@tty5.service \
    getty@tty6.service

# These services are pulled in by Fedora's systemd-container package, which is
# needed for systemd-pull, but CarbideOS does not expose their APIs.
for unit in \
    systemd-importd.service \
    systemd-importd.socket \
    systemd-machined.service \
    systemd-machined.socket \
    systemd-nsresourced.service \
    systemd-nsresourced.socket; do
    ln -sf /dev/null "/etc/systemd/system/$unit"
done

ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
