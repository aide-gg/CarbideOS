#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

password_file=/var/lib/carbideos/ace-mgmt.password
if [ -s /usr/lib/carbideos/ace-mgmt.password ]; then
    password=$(cat /usr/lib/carbideos/ace-mgmt.password)
elif [ -s "$password_file" ]; then
    password=$(cat "$password_file")
else
    install -d -m 0700 /var/lib/carbideos
    password=$(head -c 48 /dev/urandom | base64)
    printf '%s\n' "$password" >"$password_file"
    chmod 0600 "$password_file"
fi

admin_group=$(cat /usr/lib/carbideos/admin-group)
if ! homectl inspect ace-mgmt >/dev/null 2>&1; then
    key=$(cat /usr/lib/carbideos/authorized_keys/ace-mgmt)
    NEWPASSWORD=$password homectl create ace-mgmt \
        --storage=subvolume \
        --shell=/bin/bash \
        --member-of="$admin_group" \
        --password-change-now=no \
        --ssh-authorized-keys="$key" \
        -P
fi

child=
# shellcheck disable=SC2317
cleanup() {
    [ -z "$child" ] || kill "$child" 2>/dev/null || true
    [ -z "$child" ] || wait "$child" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

env PASSWORD="$password" homectl with ace-mgmt /usr/bin/sleep infinity &
child=$!
unset password

attempt=0
while [ "$attempt" -lt 100 ]; do
    attempt=$((attempt + 1))
    if ! kill -0 "$child" 2>/dev/null; then
        wait "$child"
        exit $?
    fi
    if homectl inspect ace-mgmt --json=short 2>/dev/null | \
        grep -Fq '"state":"active"'; then
        systemd-notify --ready
        if wait "$child"; then
            status=0
        else
            status=$?
        fi
        child=
        exit "$status"
    fi
    sleep 0.1
done

printf '%s\n' 'Timed out waiting for the ace-mgmt home to activate.' >&2
exit 1
