# SPDX-License-Identifier: AGPL-3.0-or-later
[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://updates.aide.gg/carbideos
MatchPattern=carbideos_@v_@u.root.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=carbideos_@v_root
MatchPartitionType=root
PartitionFlags=0
ReadOnly=yes
InstancesMax=2
