[Transfer]
ProtectVersion=%A
Verify=yes

[Source]
Type=url-file
Path=https://updates.aide.gg/carbideos
MatchPattern=carbideos_@v.verity-sig.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=carbideos_@v_verity_sig
MatchPartitionType=root-verity-sig
PartitionFlags=0
ReadOnly=yes
InstancesMax=2
