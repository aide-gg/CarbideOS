[Unit]
Description=Retry a counted CarbideOS boot that reached emergency mode
DefaultDependencies=no
After=emergency.target
ConditionPathExistsGlob=/sys/firmware/efi/efivars/LoaderBootCountPath-*

[Service]
Type=oneshot
ExecStart=/usr/bin/sleep 15
ExecStart=/usr/bin/systemctl reboot --force

[Install]
WantedBy=emergency.target
