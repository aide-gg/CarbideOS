#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

PATH=/usr/sbin:/usr/bin
export PATH
unset CDPATH ENV BASH_ENV GPG_TTY SSH_AUTH_SOCK

[ "$(id -u)" -eq 0 ] || {
    printf '%s\n' 'carbideos-ops must be invoked through sudo.' >&2
    exit 1
}

usage() {
    printf '%s\n' \
        'Usage: carbideos-ops health|reboot|poweroff|update' \
        '       carbideos-ops logs                   system warnings this boot' \
        '       carbideos-ops logs watchtower        the supervisor, all priorities' \
        '       carbideos-ops logs job ID            one ACE job, all priorities' \
        '       carbideos-ops stop-job ID' \
        '       carbideos-ops extension install|remove rat-game-16' \
        '       carbideos-ops node-id' \
        '       carbideos-ops credential NAME        (value on stdin)' \
        '       carbideos-ops install-extension NAME (image on stdin)' >&2
    exit 2
}

# The base version an extension image declares it was built for.
#
# Read from the image rather than taken from the caller, because this decides
# the file name the image is stored under and therefore which base merges it.
image_base_version() {
    # Anchored on the opening quote, because SYSEXT_VERSION_ID ends in the same
    # text and an unanchored match also finds the extension's own version. That
    # would pin the image to a base version that does not exist, and nothing
    # would ever merge it.
    /usr/bin/systemd-dissect --json=short "$1" 2>/dev/null \
        | /usr/bin/grep -o '"sysextRelease":\[[^]]*\]' \
        | /usr/bin/grep -o '"VERSION_ID=[^"]*' \
        | /usr/bin/head -1 \
        | /usr/bin/cut -d= -f2
}

# Only a plain version may be interpolated into a path.
version_valid() {
    printf '%s' "$1" | /usr/bin/grep -qE '^[A-Za-z0-9][A-Za-z0-9._-]*$'
}

running_base_version() {
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '%s' "$VERSION_ID"
}

# A job identifier, and nothing else, may be interpolated into a unit name.
# Without this an operator could name any unit on the system and this would stop
# it or read its journal.
job_unit() {
    printf '%s' "$1" | /usr/bin/grep -qE \
        '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || {
        printf 'Not a job identifier: %s\n' "$1" >&2
        exit 2
    }
    printf 'ace@%s.service' "$1"
}

# Credentials a node may be given during provisioning. Restricting the names is
# what keeps this from being an arbitrary write into the credential store.
credential_permitted() {
    case "$1" in
        GITHUB_TOKEN|REDIS_URL|ABLY_API_KEY|GCP_KMS_CREDENTIALS_B64) return 0 ;;
        OPENAI_API_KEY|OPENROUTER_API_KEY|GOOGLE_GENERATIVE_AI_API_KEY) return 0 ;;
        CONVEX_SERVER_SECRET_DEV|CONVEX_SERVER_SECRET_PROD) return 0 ;;
        *) return 1 ;;
    esac
}

# Extensions a node may be given directly. Watchtower is deliberately not
# published to the update feed, so it can only arrive this way.
extension_permitted() {
    case "$1" in
        watchtower|chrome|rat-game-16) return 0 ;;
        *) return 1 ;;
    esac
}

[ "$#" -ge 1 ] || usage
operation=$1
shift
/usr/bin/logger --priority=authpriv.notice --tag=carbideos-ops -- \
    "operator=${SUDO_USER:-unknown} operation=$operation arguments=$*"

case "$operation" in
    health)
        [ "$#" -eq 0 ] || usage
        /usr/bin/env -i PATH="$PATH" \
            /usr/bin/systemctl --failed --no-pager
        /usr/bin/env -i PATH="$PATH" \
            /usr/bin/systemctl is-system-running --wait
        ;;
    logs)
        # Without a unit this stays at warning and above, because the whole
        # system journal at every priority is more than an operator needs and
        # belongs to services this tool has no business exposing.
        #
        # The two units below are the ones a node exists to run, and an operator
        # who can already write credentials and install extensions here gains
        # nothing by reading them. Diagnosing a node without them meant guessing
        # from a failed unit and a truncated warning, which is how a job that
        # finished its work but never exited went unnoticed on two nodes.
        case "${1-}" in
            '')
                exec /usr/bin/env -i PATH="$PATH" \
                    /usr/bin/journalctl --boot --priority=warning..alert \
                        --lines=300 --no-pager
                ;;
            watchtower)
                [ "$#" -eq 1 ] || usage
                exec /usr/bin/env -i PATH="$PATH" \
                    /usr/bin/journalctl --boot --unit=watchtower.service \
                        --lines=500 --no-pager
                ;;
            job)
                [ "$#" -eq 2 ] || usage
                unit=$(job_unit "$2")
                exec /usr/bin/env -i PATH="$PATH" \
                    /usr/bin/journalctl --boot --unit="$unit" \
                        --lines=500 --no-pager
                ;;
            *) usage ;;
        esac
        ;;
    stop-job)
        # Stopping the unit is all this does. Watchtower notices it go inactive
        # on its next sweep and retires the job itself, releasing the queue
        # entry and the execution lease through the ordinary path, so this does
        # not touch Redis and cannot leave a half retired job behind.
        [ "$#" -eq 1 ] || usage
        unit=$(job_unit "$1")
        /usr/bin/systemctl list-units --all --no-legend "$unit" 2>/dev/null \
            | /usr/bin/grep -q . || {
            printf 'No such job on this node: %s\n' "$1" >&2
            exit 1
        }
        /usr/bin/env -i PATH="$PATH" /usr/bin/systemctl stop "$unit"
        printf 'job %s stopped\n' "$1"
        ;;
    reboot)
        [ "$#" -eq 0 ] || usage
        if /usr/lib/systemd/systemd-sysupdate pending; then
            exec /usr/bin/env -i PATH="$PATH" \
                /usr/lib/systemd/systemd-sysupdate reboot
        fi
        exec /usr/bin/env -i PATH="$PATH" /usr/bin/systemctl reboot
        ;;
    poweroff)
        [ "$#" -eq 0 ] || usage
        exec /usr/bin/env -i PATH="$PATH" /usr/bin/systemctl poweroff
        ;;
    update)
        [ "$#" -eq 0 ] || usage
        /usr/bin/env -i PATH="$PATH" \
            /usr/lib/systemd/systemd-sysupdate update
        /usr/bin/sync
        if /usr/lib/systemd/systemd-sysupdate pending; then
            # shellcheck disable=SC1091
            . /etc/os-release
            set -- "/boot/EFI/Linux/${IMAGE_ID}_"*+*-*.efi
            if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
                printf '%s\n' \
                    'Expected exactly one pending counted UKI.' >&2
                exit 1
            fi
            /usr/bin/bootctl set-oneshot "$(basename "$1")"
        fi
        ;;
    node-id)
        # Read-only, and not a secret: the node publishes this to the fleet in
        # its hello. Provisioning needs it to address the node afterwards.
        [ "$#" -eq 0 ] || usage
        [ -s /var/lib/watchtower/node-id ] || {
            printf 'This node has no identity yet\n' >&2
            exit 1
        }
        exec /usr/bin/cat /var/lib/watchtower/node-id
        ;;
    credential)
        # Provisioning writes per-node secrets that are deliberately not
        # compiled into the image, the release token above all. The value
        # arrives on stdin so it never reaches the process table or the
        # operator's shell history.
        [ "$#" -eq 1 ] || usage
        credential_permitted "$1" || {
            printf 'Refusing to write credential %s\n' "$1" >&2
            exit 2
        }
        directory=/var/lib/watchtower/credentials
        /usr/bin/install -d -m 0700 -o root -g root "$directory"
        staging="$directory/.$1.staging"
        /usr/bin/head -c 65536 >"$staging"
        [ -s "$staging" ] || {
            /usr/bin/rm -f "$staging"
            printf 'Refusing to write an empty credential %s\n' "$1" >&2
            exit 1
        }
        /usr/bin/chmod 0600 "$staging"
        /usr/bin/mv -f "$staging" "$directory/$1"
        printf 'credential %s installed\n' "$1"
        ;;
    install-extension)
        # A signed extension image supplied directly rather than fetched from
        # the update feed. Watchtower is never published to the feed, so this is
        # the only way it can reach a node.
        #
        # The image is not trusted because it arrived here: the merge below
        # enforces verity and a signature made by a key in the sealed base
        # image, and an image that fails is removed again.
        [ "$#" -eq 1 ] || usage
        extension_permitted "$1" || {
            printf 'Refusing to install extension %s\n' "$1" >&2
            exit 2
        }
        policy=root=verity+signed+absent:usr=verity+signed+absent
        /usr/bin/install -d -m 0755 /var/lib/extensions
        # Staged outside the extensions directory and under a .raw name.
        # systemd-dissect decides how to read a file from its suffix and
        # reports nothing at all for one it does not recognise, so the version
        # cannot be read from a file named .staging. A .raw file cannot be
        # staged in the extensions directory either, because systemd-sysext
        # merges every one of those. Same filesystem, so the move below is a
        # rename rather than a second copy of a very large file.
        /usr/bin/install -d -m 0700 /var/lib/carbide/staging
        staging="/var/lib/carbide/staging/$1.raw"
        /usr/bin/head -c 1073741824 >"$staging"
        [ -s "$staging" ] || {
            /usr/bin/rm -f "$staging"
            printf 'Refusing to install an empty extension image\n' >&2
            exit 1
        }
        # The image is stored under the base version it declares, so images for
        # the running base and for a pending one can sit here together and
        # systemd merges whichever matches. That is what makes a base update
        # survivable: the outgoing base keeps its extension, and a rollback
        # finds it still in place.
        image_version=$(image_base_version "$staging")
        if ! version_valid "$image_version"; then
            /usr/bin/rm -f "$staging"
            printf 'Extension %s declares no usable base version\n' "$1" >&2
            exit 1
        fi
        trap '/usr/bin/rm -f "$staging"' EXIT HUP INT TERM
        running=$(running_base_version)
        # An underscore, because systemd strips a version from an image name
        # only after that separator. With any other one it looks for an
        # extension-release named after the whole string, does not find it, and
        # reports the image unreadable rather than incompatible, which fails
        # the whole merge and takes every other extension down with it.
        target="/var/lib/extensions/$1_$image_version.raw"
        previous=
        if [ -f "$target" ]; then
            previous="/var/lib/extensions/.$1.previous"
            /usr/bin/cp -f "$target" "$previous"
        fi
        /usr/bin/chmod 0644 "$staging"
        /usr/bin/mv -f "$staging" "$target"
        # An unscoped image predates scoping and is always superseded by this
        # one, whatever base it was built for. Removing it only on a version
        # match was not enough: an older image that still declares SYSEXT_LEVEL
        # matches any base that also declares one, so it merged alongside the
        # scoped image and the node ran two copies of the same extension.
        /usr/bin/rm -f "/var/lib/extensions/$1.raw"
        # An image built for a base that is not running is staged, not broken:
        # it merges when that base boots. Only an image for the running base is
        # expected to merge now.
        #
        # A refresh exits zero even when it silently skips a mismatched image,
        # so its status alone would report success for an extension that never
        # merged. For the running base the merged tree is the only honest
        # evidence.
        merged_ok=0
        if /usr/bin/env -i PATH="$PATH" \
            /usr/bin/systemd-sysext --image-policy="$policy" refresh; then
            # Written as a plain if, because an && list that fails here is the
            # last command in this branch and set -e would abort the script
            # before the image below could be rolled back.
            if [ "$image_version" != "$running" ]; then
                merged_ok=1
            elif [ -f "/usr/lib/extension-release.d/extension-release.$1" ]; then
                merged_ok=1
            fi
        fi
        if [ "$merged_ok" -eq 1 ]; then
            /usr/bin/rm -f "$previous"
            # A refresh does not restart a service that is already running, so
            # it would keep executing the previous image until something else
            # restarted it. Only worth doing when something actually changed
            # under it; a staged image has not been merged and restarting for
            # it would interrupt a healthy supervisor for no reason.
            if [ "$image_version" = "$running" ] && \
               /usr/bin/systemctl list-unit-files watchtower.service >/dev/null 2>&1; then
                /usr/bin/env -i PATH="$PATH" \
                    /usr/bin/systemctl restart watchtower.service || true
            fi
            # Keep the running base's image and one neighbour, so a rollback
            # still finds its extension while the state partition stays bounded.
            # These are hundreds of megabytes each.
            for stale in $(/usr/bin/ls -1 "/var/lib/extensions/$1_"*.raw 2>/dev/null \
                | /usr/bin/sed "s|.*/$1_||;s|\.raw$||" \
                | /usr/bin/sort -V | /usr/bin/head -n -2); do
                if [ "$stale" != "$running" ]; then
                    /usr/bin/rm -f "/var/lib/extensions/$1_$stale.raw"
                fi
            done
            if [ "$image_version" = "$running" ]; then
                printf 'extension %s installed\n' "$1"
            else
                printf 'extension %s staged for CarbideOS %s\n' "$1" "$image_version"
            fi
        else
            if [ -n "$previous" ]; then
                /usr/bin/mv -f "$previous" "$target"
            else
                /usr/bin/rm -f "$target"
            fi
            /usr/bin/env -i PATH="$PATH" \
                /usr/bin/systemd-sysext --image-policy="$policy" refresh || true
            printf 'Extension %s did not merge and has been removed\n' "$1" >&2
            printf 'It is signed for a different CarbideOS version, or its verity signature was refused.\n' >&2
            exit 1
        fi
        ;;
    extension)
        [ "$#" -eq 2 ] || usage
        case "$1:$2" in
            install:rat-game-16|remove:rat-game-16)
                exec /usr/bin/env -i PATH="$PATH" \
                    /usr/sbin/carbideos-extension "$1" "$2"
                ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
