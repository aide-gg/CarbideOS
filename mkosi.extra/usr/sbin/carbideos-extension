#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

[ "$(id -u)" -eq 0 ] || { printf '%s\n' 'Must run as root.' >&2; exit 1; }
[ "$#" -eq 2 ] || { printf 'Usage: %s install|remove NAME\n' "$0" >&2; exit 2; }

action=$1
name=$2
# shellcheck disable=SC1091
. /usr/lib/os-release
case "$name" in
    chrome|rat-game-16) ;;
    *)
        printf 'Unknown extension: %s\n' "$name" >&2
        exit 1
        ;;
esac
# Watchtower is deliberately absent: it is not published to the feed and
# arrives only through carbideos-ops install-extension.
artifact="${name}_${VERSION_ID}.sysext.raw"

# Scoped to the base it was built for, matching install-extension, so an image
# for the running base and one for a pending base can sit here together.
target="/var/lib/extensions/${name}_${VERSION_ID}.raw"
policy=root=verity+signed+absent:usr=verity+signed+absent
case "$action" in
    install)
        install -d -m 0755 /var/lib/extensions
        temporary=$(mktemp "/var/lib/extensions/.$name.XXXXXX")
        trap 'rm -f "$temporary"' EXIT HUP INT TERM
        /usr/lib/systemd/systemd-pull raw --direct --verify=no \
            --class=sysext --size-max=64M \
            "https://updates.aide.gg/carbideos/$artifact" "$temporary"
        chmod 0644 "$temporary"
        mv -f "$temporary" "$target"
        # An unscoped image predates scoping and merges alongside this one,
        # leaving the node running two copies of the same extension.
        rm -f "/var/lib/extensions/$name.raw"
        if ! systemd-sysext --image-policy="$policy" refresh; then
            rm -f "$target"
            systemd-sysext --image-policy="$policy" refresh || true
            exit 1
        fi
        ;;
    remove)
        rm -f "$target" "/var/lib/extensions/$name.raw"
        systemd-sysext --image-policy="$policy" refresh
        ;;
    *)
        printf 'Unknown action: %s\n' "$action" >&2
        exit 2
        ;;
esac
