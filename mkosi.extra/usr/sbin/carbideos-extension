#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

[ "$(id -u)" -eq 0 ] || { printf '%s\n' 'Must run as root.' >&2; exit 1; }
[ "$#" -eq 2 ] || { printf 'Usage: %s install|remove NAME\n' "$0" >&2; exit 2; }

action=$1
name=$2
case "$name" in
    chrome|rat-game-16) ;;
    *)
        printf 'Unknown extension: %s\n' "$name" >&2
        exit 1
        ;;
esac
# Watchtower is deliberately absent: it is not published to the feed and
# arrives only through carbideos-ops install-extension.

case "$action" in
    install)
        # The agent fetches through the extension's sealed sysupdate component,
        # which verifies the signed feed manifest and picks the newest revision
        # for the running base.
        /usr/bin/carbide-agent stage-extension "$name" --activate
        ;;
    remove)
        /usr/bin/carbide-agent remove "$name"
        ;;
    *)
        printf 'Unknown action: %s\n' "$action" >&2
        exit 2
        ;;
esac
