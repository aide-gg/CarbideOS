#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

[ "$(id -u)" -eq 0 ] || { printf '%s\n' 'Must run as root.' >&2; exit 1; }
[ "$#" -eq 2 ] || { printf 'Usage: %s install|remove NAME\n' "$0" >&2; exit 2; }

action=$1
name=$2
# shellcheck disable=SC1091
. /usr/lib/os-release
case "$name" in
    chrome|rat-game-16) ;;
    *)
        printf 'Unknown extension: %s\n' "$name" >&2
        exit 1
        ;;
esac
# Watchtower is deliberately absent: it is not published to the feed and
# arrives only through carbideos-ops install-extension.
# Published compressed; systemd-pull decompresses a raw image by its suffix.
artifact="${name}_${VERSION_ID}.sysext.raw.zst"

case "$action" in
    install)
        install -d -m 0700 /run/carbide/staging
        temporary=$(mktemp "/run/carbide/staging/${name}.XXXXXX.raw")
        trap 'rm -f "$temporary"' EXIT HUP INT TERM
        /usr/lib/systemd/systemd-pull raw --direct --verify=no \
            --class=sysext --size-max=1G \
            "https://updates.aide.gg/carbideos/$artifact" "$temporary"
        chmod 0644 "$temporary"
        digest=$(sha256sum "$temporary" | awk '{print $1}')
        /usr/bin/carbide-agent stage-extension "$name" --base "$VERSION_ID" \
            --path "$temporary" --digest "$digest" --activate
        ;;
    remove)
        /usr/bin/carbide-agent remove "$name"
        ;;
    *)
        printf 'Unknown action: %s\n' "$action" >&2
        exit 2
        ;;
esac
